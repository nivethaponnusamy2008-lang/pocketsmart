{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "PocketSmart AI: Run local server",
			"type": "shell",
			"command": "py",
			"args": [
				"-m",
				"uvicorn",
				"app.main:app",
				"--reload",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"options": {
				"cwd": "${workspaceFolder}/pocketsmart_ai"
			},
			"isBackground": true,
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}